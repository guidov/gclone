[Unit]
Description=gclone Mount for Google Drive (Dropbox Replacement)
Documentation=https://github.com/l3v11/gclone
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Adjust the username and mount point before installing this unit.
# Install both /usr/local/bin/gclone and /usr/local/bin/gclone-mount first.
User=YOUR_USERNAME
Group=YOUR_USERNAME
# Create an empty filter file on first start so --filter-from does not error
ExecStartPre=/bin/bash -c 'mkdir -p %h/.config/rclone && touch -a %h/.config/rclone/gclone-selective-sync.txt'
ExecStart=/usr/local/bin/gclone-mount gc: /path/to/mountpoint \
  --filter-from=%h/.config/rclone/gclone-selective-sync.txt

# Ensure the mount point exists and is unmounted on stop
ExecStop=-/bin/fusermount -uz /path/to/mountpoint
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
